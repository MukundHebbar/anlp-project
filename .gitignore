__pycache__/
*.py[oc]
build/
dist/
wheelhouse/
wheelhouse
wheels/
*.egg-info
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Virtual environments
.venv

# Local data, archives, and generated runs
data/datasets/
data/datasets
local/
logs/
*.log
slurm-*.out
slurm-*.err
data/legacy-*/
docs/guides/turing.md

# The final dataset is tracked as .jsonl.gz: the raw train files exceed GitHub's 100 MB limit.
data/manifests/final-v3/*.jsonl
data/manifests/final-v3.zip

.env
**/.env

# Notebook and editor state
.ipynb_checkpoints/
.DS_Store
.vscode/

# Raw model responses and judge calls are tracked gzipped (.jsonl.gz), for the reported runs only.
artifacts/**/responses.jsonl
artifacts/**/judgments.jsonl
# OPD run logs are records.
!artifacts/opd/**/*.log
